!**/testdata/**/*.key
secrets/

# Local runtime state. Note that examples/ is NOT ignored: the two corpora and
# the recorded baseline are part of the repository — they are what makes
# `git clone && python tasks.py all` work on a fresh checkout — and an
# over-broad rule over generated files would silently exclude them.
var/
*.db
*.sqlite
*.sqlite3
*.log

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Build artifacts
*.sarif
sbom.json

# Generated by the task runner, never committed. The site is built from the
# Markdown already in the repository, and the audit requirements file is
# exported from uv.lock on every run of `python tasks.py security`.
_site/
requirements.audit.txt

# Reports the gate writes. The committed corpus is the input; the verdicts
# over it are reproducible from it, so they are an artefact, not a source.
# reports/ is deliberately NOT ignored. `reports/evaluation.md` is the
# published measurement the README and the docs link to, and a link into a
# directory nobody committed is a 404 for every reader. It is regenerated by
# `python tasks.py evaluate`, and like examples/baseline.json it should move
# in its own commit so the diff shows what changed.
