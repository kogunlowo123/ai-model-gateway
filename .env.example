# Every variable the gateway reads. Copy to `.env` and edit.
#
# There are no credentials here, and that is not an oversight. This gateway
# routes between simulated upstreams, so it has nothing to authenticate to; the
# only real provider it can talk to is a local Ollama server, which has no key.
# If you add a hosted provider, its key belongs in your secret manager and in
# `.gitignore`, never in this file or any file next to it.
#
# Names are checked at startup. A misspelt `AMG_` variable is a *startup
# failure*, not a shrug -- see `Settings.from_environment`. That check exists
# because pydantic-settings walks from field names to the environment, so
# `extra="forbid"` alone never sees `AMG_CONCURENCY=48`, and a carefully set
# value that does nothing is the worst kind of configuration bug.

# --- routing ---------------------------------------------------------------

# Which policy the HTTP surface and `amg ask` use by default.
#   cheapest  always the cheapest upstream
#   best      always the most capable
#   cascade   climb the ladder while the response fails validation
#   blend     route a fixed share at random; the spend-matched null
#   fitted    the estimator, against calibrated thresholds
AMG_POLICY=cascade

# Required when AMG_POLICY=fitted. Startup fails without it rather than
# silently falling back to always-cheapest, which looks like a cost saving and
# is a quality regression.
# AMG_ESTIMATOR_PATH=examples/estimator.json

# Required when AMG_POLICY=fitted. Produced by `amg calibrate`.
# AMG_THRESHOLD_HIGH=779933
# AMG_THRESHOLD_LOW=-2676792

# Required when AMG_POLICY=blend, in parts per ten thousand. Also from
# `amg calibrate`, which sizes them against the fitted router's spend.
# AMG_BLEND_TO_CHEAP=8847
# AMG_BLEND_TO_MIDDLE=625

# What `amg calibrate` aims to spend, as a multiple of always-cheapest.
AMG_BUDGET_MULTIPLE=3

# --- resilience ------------------------------------------------------------

# Attempts per upstream, including the first. 1 disables retrying.
AMG_MAX_ATTEMPTS=2

# First backoff interval, in microseconds. Doubles per attempt.
AMG_BACKOFF_BASE_US=50000

# How long one call may take. This is per attempt and starts when the call
# starts -- which is *after* any time spent queueing.
AMG_TIMEOUT_US=2000000

# How long the whole request may take, queueing included. Must be at least
# AMG_TIMEOUT_US or no complete attempt could ever fit, and startup says so.
#
# This is the one that matters under load. A per-attempt timeout cannot see a
# queue, so with only a timeout set, latency grows without bound while the
# error rate stays flat and every dashboard looks healthy.
AMG_DEADLINE_US=6000000

# Concurrent upstream calls. The resilience sweep measures this as the variable
# that decides whether a circuit breaker helps or hurts: a breaker fails traffic
# over to a slower provider, and a pool sized for the fast one cannot absorb it.
AMG_CONCURRENCY=24

# Trip after consecutive failures and stop calling a dead upstream. Useful
# against an outage, close to useless against elevated independent errors, and
# actively harmful on an under-provisioned pool. See docs/resilience.md.
AMG_BREAKER_ENABLED=true

# --- the HTTP surface ------------------------------------------------------

# Bound to loopback by default. This server has no authentication, because it
# has nothing to protect and adding a token would imply otherwise; put it
# behind something that does before exposing it.
AMG_HOST=127.0.0.1
AMG_PORT=8000
